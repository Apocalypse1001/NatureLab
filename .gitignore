# build artifacts (rebuildable via build_exe.bat / npm run build)
NatureLab.exe
frontend/dist/
frontend/node_modules/
tests/node_modules/
runtime/

# python
__pycache__/
*.pyc
.venv/

# logs / local run artifacts
*.log
*.err
data/*.json
!data/.gitkeep
# ...except the prepared scenarios, which are product content rather than
# somebody's saved experiment: without them in the repo a fresh clone has
# Scenarios buttons that load nothing. Rebuilt by tools/make_scenarios.py.
!data/scenario_*.json

# os
.DS_Store
Thumbs.db

# agent driver screenshots (run artifacts, see .claude/skills/run-naturelab/)
.claude/skills/run-naturelab/shots/

# release archives (rebuildable via tools/make_release.py; kept out of git for size)
releases/*.zip
# unpacked release trees (a copy of the source; rebuildable from the zip)
releases/*/

# third-party reference implementations (study material, not project source)
reference/
